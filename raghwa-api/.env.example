# Copy to .env and adjust. Every variable is validated at startup (src/config/env.validation.ts).
NODE_ENV=development
PORT=3000
# Local time used for "today", slot availability and stats.
APP_TIMEZONE=Africa/Tunis
# Comma-separated origins allowed by CORS (garage-web dev server). The mobile app does not need CORS.
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true

DB_HOST=localhost
DB_PORT=5432
DB_USER=raghwa
DB_PASSWORD=raghwa
DB_NAME=raghwa
DB_LOGGING=false

# Use long random values in production (e.g. `openssl rand -base64 48`). Each app has its own secret.
JWT_OWNER_SECRET=change-me-owner-secret-at-least-32-characters
JWT_CUSTOMER_SECRET=change-me-customer-secret-at-least-32-chars
JWT_RESET_SECRET=change-me-password-reset-secret-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# "console" logs the SMS (development). Plug a real provider in src/core/auth/sms/.
SMS_DRIVER=console

# Push notifications to the mobile app: "expo" (Expo Push Service) or "console" (log only).
PUSH_DRIVER=expo
# Only if "Enhanced security for push notifications" is enabled on expo.dev.
EXPO_ACCESS_TOKEN=

# Requests per minute per IP.
THROTTLE_LIMIT=120
